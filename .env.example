# Clerk (required for sign-in / gated site)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Use deployed backend API URL in production, e.g. https://your-backend.up.railway.app
# For local development, keep this empty so CRA proxy forwards to http://localhost:5000
REACT_APP_API_URL=

# Socket.IO server for the Confess (personal) chat.
# Defaults to REACT_APP_API_URL when unset - set it only if the socket
# server lives on a different host than the REST API.
# REACT_APP_SOCKET_URL=https://relationship-care.onrender.com
